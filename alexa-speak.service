[Unit]
Description=Alexa Speak API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swirhen
Group=swirhen
WorkingDirectory=/home/swirhen/alexa_speak
# REFRESH_TOKEN などはここに書く（root 所有・600）
EnvironmentFile=-/etc/default/alexa-speak
Environment=AMAZON=amazon.co.jp
Environment=ALEXA=alexa.amazon.co.jp
Environment=TTS_LOCALE=ja-JP
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/swirhen/alexa_speak/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
