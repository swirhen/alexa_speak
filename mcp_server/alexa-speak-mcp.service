[Unit]
Description=Alexa Speak MCP server (remote MCP for AI connectors)
After=network-online.target alexa-speak.service
Wants=network-online.target

[Service]
Type=simple
User=swirhen
Group=swirhen
WorkingDirectory=/home/swirhen/alexa_speak/mcp_server
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/swirhen/alexa_speak/mcp_server/.venv/bin/python server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
