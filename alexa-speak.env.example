# /etc/default/alexa-speak にコピーして値を入れる（sudo chmod 600）
# alexa-cookie-cli で取得した Atnr| で始まるトークン
REFRESH_TOKEN=
# POST /speak で device を省略したときの端末名（-a で表示される名前）
ALEXA_DEFAULT_DEVICE=
# 読み上げ時の音量（0 は変更しない）
SPEAKVOL=0
# API の ID とパスワード（呼び出し元の AI ごとに "id:password" をカンマ区切りで並べる）
# パスワードの作成例: openssl rand -hex 24
ALEXA_SPEAK_CLIENTS=
