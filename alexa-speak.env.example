# /etc/default/alexa-speak にコピーして値を入れる（sudo chmod 600）
# Amazon の Atnr| で始まるトークン。通常は空でよい（管理ページからログインすると alexa_token.json に保存され、そちらが優先される）
REFRESH_TOKEN=
# POST /speak で device を省略したときの端末名の初期値（管理ページで保存すると settings.json が優先される）
ALEXA_DEFAULT_DEVICE=
# 読み上げの前に鳴らす音（soundbank:// URL）。行が無ければドアチャイム、空ならチャイムなし
#ALEXA_SPEAK_CHIME=soundbank://soundlibrary/home/amzn_sfx_doorbell_chime_01
# 管理ページ（/admin）の管理者 "id:password"。空なら管理ページは使えない
# パスワードの作成例: openssl rand -hex 16
ALEXA_SPEAK_ADMIN=
